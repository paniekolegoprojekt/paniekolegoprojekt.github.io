{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "atoms": ["./src/ui/atoms"],
      "$ui/*": ["./src/ui/*"],
      "@src": ["src"],
      "@/molecules": ["./src/ui/molecules"],
      "@/organisms": ["./src/ui/organisms"],
      "@atoms": ["./src/ui/components/atoms/index.ts"],
      "@atoms/*": ["./src/ui/components/atoms"]
    }
  },
  "include": ["vite.config.ts"]
}
